[Desktop Entry]
Type=Application
Name=SoundZ
GenericName=Digital Audio Workstation
Comment=Record, edit and mix audio and MIDI
Exec=soundz %F
TryExec=soundz
Icon=com.pintaz.soundz
Terminal=false
StartupNotify=true
